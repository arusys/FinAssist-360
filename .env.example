# Application
PROJECT_NAME="FinAssist 360 – GenAI-Based Banking Service Management"
VERSION=1.0.0
API_V1_STR=/api

# Security & Tokens
SECRET_KEY=finassist360-enterprise-banking-security-key-2025-token-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; supports PostgreSQL)
DATABASE_URL=sqlite:///./finassist360.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finassist360

# Generative AI Provider (demo, gemini, openai, anthropic)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Server Port
PORT=8000
